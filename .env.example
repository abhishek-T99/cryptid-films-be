# Cryptid Films — backend environment
#
# Copy this file to `.env` and fill in the blanks:
#   cp .env.example .env
#
# `.env` is git-ignored; this file is committed and is the list of every
# variable the project reads. Add new variables here whenever you add one to
# settings.py, with a safe placeholder rather than a real value.

# --- Core -----------------------------------------------------------------

# Required, no default. Generate one with:
#   python -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(50)))"
DJANGO_SECRET_KEY=

# Never true outside local development.
DJANGO_DEBUG=True

# Comma-separated. Must list every hostname the backend is served on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_TIME_ZONE=Asia/Kathmandu

# --- Database -------------------------------------------------------------

# Absolute or project-relative path to the SQLite file. In production point
# this at a path on persistent storage, outside the deployment directory, so
# a redeploy cannot replace it.
DJANGO_SQLITE_PATH=db.sqlite3

# --- Frontend origins -----------------------------------------------------

# Comma-separated, scheme included, no trailing slash. The Vite dev server
# defaults to port 5173; add the production domain when you deploy.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave blank to reuse DJANGO_CORS_ALLOWED_ORIGINS.
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Email ----------------------------------------------------------------
# Ignored while DEBUG is on: mail is printed to the console instead.

DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=noreply@cryptidfilms.com

# --- Production hardening -------------------------------------------------
# Only read when DJANGO_DEBUG is False.

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
